# ───────────────────────────────────────────────────────────────────────────
# Tatami Pass · nube (apps/registration) · variables de entorno
# Copia a .env.local para desarrollo. En Vercel: Settings → Environment Variables.
# ───────────────────────────────────────────────────────────────────────────

# ── Base de datos ──────────────────────────────────────────────────────────
# Sin DATABASE_URL se usa SQLite local (REGISTRATION_DB_PATH). En Vercel es obligatoria (Neon).
# Neon: usa la cadena "pooled" (host con -pooler) para serverless.
# DATABASE_URL=postgres://usuario:clave@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# REGISTRATION_DB_PATH=data/registration.db      # solo SQLite
# PGSSL=disable                                  # fuerza sin TLS (Postgres local sin certificado)
# PG_POOL_MAX=3                                  # conexiones por instancia
# PG_SCHEMA=                                     # esquema alternativo (tests usan tp_test)

# ── Sesiones del panel ─────────────────────────────────────────────────────
# Obligatoria en producción, ≥ 32 caracteres aleatorios:  openssl rand -base64 48
SESSION_SECRET=
# Primer administrador: se crea al migrar/arrancar si todavía no hay usuarios.
ADMIN_EMAIL=admin@ejemplo.co
ADMIN_PASSWORD=cambia-esta-clave-123
ADMIN_NAME=Administrador
# PASSWORD_HASH=scrypt                           # fuerza scrypt si @node-rs/argon2 no carga en tu plataforma

# ── Host ↔ nube ────────────────────────────────────────────────────────────
# Clave compartida: el host la manda como cabecera x-tatami-key en /api/export, /api/approve y /api/host-report.
# Un administrador puede regenerarla en Panel › Exportar; la generada allí manda sobre esta variable.
# En el host se configura como TP_CLOUD_KEY junto con TP_CLOUD_URL=https://<tu-dominio>.
TP_CLOUD_KEY=cambia-esta-clave-compartida

# ── Credencial digital (QR rotativo para roles con allowsDigital: General, Acompañante) ──
# JSON con la MISMA clave Ed25519 del host (ver docs/85 §7 y apps/host/.env.example). Sin ella la página
# /credencial/<token> muestra el estado pero no el QR. El QR además necesita que el host haya reportado el
# ID de la credencial (lo hace solo tras cada "Traer ahora" / pull periódico, POST /api/host-report).
# Exportar la clave del host:  cd apps/host && TP_KEY_PASSPHRASE='…' npx tsx -e "import('./src/config.ts').then(m => console.log(JSON.stringify(m.loadSigningKey())))"
# Solo en producción; nunca en el repo.
# TP_SIGNING_KEY={"kid":"k1","privateKeyHex":"<64 hex>","publicKeyHex":"<64 hex>"}

# ── URL pública (para enlaces en correos) ──────────────────────────────────
# En Vercel se deduce de VERCEL_PROJECT_PRODUCTION_URL; ponla si usas dominio propio.
APP_URL=http://localhost:3000

# ── Correo ─────────────────────────────────────────────────────────────────
# Con RESEND_API_KEY se envía por Resend (MAIL_FROM debe ser de un dominio verificado allí).
# Sin ella, cada correo se guarda como .eml en MAIL_OUTBOX_DIR y se registra en consola.
# RESEND_API_KEY=re_xxxxxxxxx
MAIL_FROM=Tatami Pass <inscripciones@tudominio.co>
# MAIL_OUTBOX_DIR=data/outbox

# ── Fotos ──────────────────────────────────────────────────────────────────
# Con BLOB_READ_WRITE_TOKEN (Vercel Blob) las fotos van a Blob; sin él, a PHOTOS_DIR y se sirven por /api/photos/.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
# PHOTOS_DIR=data/photos
# PHOTO_REQUIRED=1                               # exige foto a los roles con requiresPhoto (por defecto es opcional)

# ── Evento ─────────────────────────────────────────────────────────────────
# Config base. En dev se lee ../host/event.config.json; en Vercel pega aquí el JSON (o deja el default del core).
# Lo que el panel cambie (cupos, categorías, textos, fechas) se guarda en la base y pisa esta base.
# EVENT_CONFIG_JSON={"eventId":"nac2026","startDate":"2026-11-20","endDate":"2026-11-22"}
# EVENT_CONFIG_PATH=../host/event.config.json

# ── Cron y límites ─────────────────────────────────────────────────────────
# Vercel Cron manda Authorization: Bearer $CRON_SECRET a /api/cron/waitlist (vence ofertas de cupo).
# CRON_SECRET=
# RATE_LIMIT_REGISTER=10                         # inscripciones por minuto por IP
# RATE_LIMIT_LOGIN=5                             # intentos de login por minuto por correo
# TP_CLOUD_INTERVAL_MIN=5                        # solo informativo en el panel (el real vive en el host)
