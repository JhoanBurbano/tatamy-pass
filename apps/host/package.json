{
  "name": "@tatami/host",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json && cp -r migrations dist/ && cp event.config.json dist/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed": "tsx src/seed.ts",
    "promote": "tsx src/promote.ts",
    "purge": "tsx src/purge-cli.ts",
    "restore": "tsx src/restore-cli.ts",
    "pretest": "npm run build -w @tatami/print",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@tatami/core": "*",
    "@tatami/print": "*",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/ws": "^8.18.2",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
