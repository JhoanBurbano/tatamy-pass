{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run check:*)",
      "Bash(npm run e2e:*)",
      "Bash(npm run simulate:*)",
      "Bash(npm run seed:*)",
      "Bash(npm run docs:*)",
      "Bash(npm run print:sample:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx tsx scripts/agent/*:*)",
      "Bash(npx tsx scripts/docs/*:*)",
      "Bash(bash scripts/agent/check-all.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(npm install:*)",
      "Bash(npm publish:*)",
      "Bash(docker:*)",
      "Bash(npx tsx scripts/agent/release.ts:*)"
    ],
    "deny": [
      "Read(./apps/host/keys/**)",
      "Read(./apps/host/.env)",
      "Read(./apps/registration/.env)",
      "Read(./apps/registration/.env.local)",
      "Read(./**/*.db)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(npm run purge:*)",
      "Bash(npm run restore:*)",
      "Bash(npm run promote:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/typecheck-workspace.sh",
            "timeout": 180
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-commit-test.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
